#!/usr/bin/env bash
# WP-CLI inside the stack: `bin/wp core version`, `bin/wp plugin list`, ...
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Without a TTY (pipes, CI, command substitution) compose must not allocate one,
# otherwise the output gets carriage returns that break `grep` and `[ x = y ]`.
tty_flag=(-T)
if [ -t 0 ] && [ -t 1 ]; then
	tty_flag=()
fi

exec docker compose run --rm "${tty_flag[@]}" wpcli wp "$@"
