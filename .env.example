# Copy to .env before running `make bootstrap`. The .env file is gitignored.
# Quote any value containing spaces: this file is both read by docker compose
# and sourced by bin/bootstrap.sh.

# Host port the site is served on. Change if 8080 is taken.
HTTP_PORT=8080

# Database. These are local-only development credentials.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# WordPress admin account created by `wp core install`.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_TITLE="WordPress Dev"

# Debugging: writes to wordpress/wp-content/debug.log.
WP_DEBUG=true
