# Copy to .env before running `make bootstrap`. The .env file is gitignored.
# Read both by Docker Compose and by config/application.php, so quote any value
# containing spaces.

# Host port the site is served on. WP_HOME below follows it automatically.
HTTP_PORT=8080

# Database. `db` is the compose service name; these are local-only credentials.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=db
DB_PREFIX=wp_
DB_ROOT_PASSWORD=root

# Environment: picks config/environments/{WP_ENV}.php.
WP_ENV=development

# Core lives in its own directory, so the site URL carries /wp and the home URL
# does not. Both are required by config/application.php.
WP_HOME=http://localhost:${HTTP_PORT}
WP_SITEURL=${WP_HOME}/wp

# WordPress admin account created by `wp core install`.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_TITLE="WordPress Dev"

# freecurrencyapi.com key for the currency module. Left empty here on purpose:
# put the real value in .env only, which is gitignored. Travels as an HTTP header,
# never a query parameter. Check it with:
#   .claude/skills/freecurrencyapi/scripts/probe-api.sh
FREECURRENCYAPI_KEY=

# Authentication keys and salts. Left empty here on purpose: bin/bootstrap.sh
# generates them into .env on first run, so no two checkouts share secrets.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
