# Local configuration — never commit, it holds credentials and salts.
.env

# Composer installs WordPress core here.
/web/wp/

# Composer dependencies.
/vendor/

# Content directory: everything is installed by Composer except our own code,
# which is re-opened below. Each level has to be re-opened for the negation
# under it to apply.
/web/app/plugins/*
!/web/app/plugins/.gitkeep
!/web/app/plugins/currency-converter/
/web/app/mu-plugins/*
!/web/app/mu-plugins/.gitkeep
!/web/app/mu-plugins/bedrock-autoloader.php
/web/app/themes/*
!/web/app/themes/test-theme/
/web/app/uploads/*
!/web/app/uploads/.gitkeep
/web/app/upgrade/
/web/app/*.log

# Front-end build artefacts.
node_modules/

# OS noise.
.DS_Store

# PHPUnit result cache.
/.phpunit.cache/
