<?xml version="1.0"?>
<ruleset name="Project">
	<description>Coding standards for the project's own PHP.</description>

	<!--
		Only code we write in WordPress's own style. Deliberately excluded:
		core and dependencies (not ours), and the Bedrock scaffolding in config/,
		web/index.php and web/wp-config.php, which follows the upstream PSR-12
		style — running phpcbf over those rewrites them into something Bedrock
		does not look like, for no benefit.
	-->
	<file>web/app/themes/test-theme</file>
	<file>web/app/mu-plugins/bedrock-autoloader.php</file>
	<file>web/app/plugins/currency-converter</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>

	<!--
		WordPress's own file naming (class-foo-bar.php) and PSR-4 cannot both hold.
		The plugin ships as a zip with a hand-written PSR-4 autoloader and no Composer
		runtime dependencies, so the class files must be named for their classes.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>web/app/plugins/currency-converter/src/*</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
